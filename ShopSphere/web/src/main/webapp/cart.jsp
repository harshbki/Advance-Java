<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Your cart | ShopSphere</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"></head>
<body><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/">ShopSphere</a><nav><a href="${pageContext.request.contextPath}/products">Continue shopping</a><form method="post" action="${pageContext.request.contextPath}/logout"><button class="link-button" type="submit">Sign out</button></form></nav></header>
<main class="content"><p class="eyebrow">YOUR SELECTION</p><h1>Shopping cart</h1><c:if test="${not empty param.added}"><p class="notice">Item added to your cart.</p></c:if><c:if test="${not empty param.error}"><p class="error">Please check the item quantity and try again.</p></c:if>
<c:choose><c:when test="${empty cartLines}"><p class="notice">Your cart is empty. <a href="${pageContext.request.contextPath}/products">Browse products</a></p></c:when><c:otherwise><div class="cart-list"><c:forEach var="line" items="${cartLines}"><article class="cart-row" style="display: flex; align-items: center; gap: 1rem;"><img src="${line.product.imageUrl.startsWith('http') ? line.product.imageUrl : pageContext.request.contextPath.concat('/').concat(line.product.imageUrl)}" alt="${line.product.name}" style="width: 64px; height: 64px; object-fit: contain; background: #fff; padding: 4px; border-radius: 8px; border: 1px solid #e2e8f0;" onerror="this.src='https://placehold.co/100x100?text=Product'"><div style="flex: 1;"><h2><c:out value="${line.product.name}"/></h2><p class="muted">₹<c:out value="${line.product.price}"/> each</p></div><form method="post" action="${pageContext.request.contextPath}/cart/update" class="quantity-form"><input type="hidden" name="cartId" value="${line.cartId}"><input type="number" name="quantity" min="1" max="${line.product.stock}" value="${line.quantity}" aria-label="Quantity"><button class="button secondary" type="submit">Update</button></form><strong>₹<c:out value="${line.lineTotal}"/></strong><form method="post" action="${pageContext.request.contextPath}/cart/remove"><input type="hidden" name="cartId" value="${line.cartId}"><button class="link-button danger" type="submit">Remove</button></form></article></c:forEach><div class="cart-actions"><a class="button" href="${pageContext.request.contextPath}/checkout">Continue to checkout</a></div></div></c:otherwise></c:choose></main></body></html>
