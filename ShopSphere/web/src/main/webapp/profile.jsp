<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Profile | ShopSphere</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"></head>
<body><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/">ShopSphere</a><nav><a href="${pageContext.request.contextPath}/orders">My orders</a><a href="${pageContext.request.contextPath}/cart">Cart</a></nav></header><main class="content"><p class="eyebrow">YOUR ACCOUNT</p><h1>Profile & addresses</h1><c:if test="${not empty param.addressAdded}"><p class="notice">Address saved.</p></c:if><c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if><div class="profile-grid"><section class="panel"><h2>Saved addresses</h2><c:forEach var="address" items="${addresses}"><article class="address-card"><strong><c:out value="${address.addressType}"/></strong><p><c:out value="${address.addressLine}"/><br><c:out value="${address.city}"/>, <c:out value="${address.state}"/> <c:out value="${address.pincode}"/></p></article></c:forEach><c:if test="${empty addresses}"><p class="muted">No saved addresses yet.</p></c:if></section><section class="panel"><h2>Add an address</h2><form method="post" action="${pageContext.request.contextPath}/profile"><label>Address<input name="addressLine" maxlength="255" required></label><label>City<input name="city" maxlength="100" required></label><label>State<input name="state" maxlength="100" required></label><label>PIN code<input name="pincode" maxlength="20" required></label><label>Address type<select name="addressType"><option>HOME</option><option>WORK</option><option>OTHER</option></select></label><button class="button" type="submit">Save address</button></form></section></div></main></body></html>
