<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Customers | ShopSphere</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"></head><body>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">ShopSphere Admin</a><nav><form method="post" action="${pageContext.request.contextPath}/logout"><button class="link-button" type="submit">Sign out</button></form></nav></header><div style="display: flex; min-height: calc(100vh - 65px);"><%@ include file="/fragments/sidebar.jsp" %><main class="content" style="flex: 1;"><h1>Customer list</h1><div class="table-wrap"><table><thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Mobile</th><th>Status</th><th>Joined</th></tr></thead><tbody><c:forEach var="u" items="${customers}"><tr><td><c:out value="${u.userId}"/></td><td><c:out value="${u.name}"/></td><td><c:out value="${u.email}"/></td><td><c:out value="${u.mobile}"/></td><td><c:out value="${u.status ? 'ACTIVE' : 'DISABLED'}"/></td><td><c:out value="${u.createdAt}"/></td></tr></c:forEach></tbody></table></div></main></div></body></html>
