<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Categories | ShopSphere</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"></head><body>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">ShopSphere Admin</a><nav><form method="post" action="${pageContext.request.contextPath}/logout"><button class="link-button" type="submit">Sign out</button></form></nav></header>
<div style="display: flex; min-height: calc(100vh - 65px);"><%@ include file="/fragments/sidebar.jsp" %><main class="content" style="flex: 1;"><h1>Category management</h1><c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if>
<section class="panel"><h2><c:choose><c:when test="${not empty editCategory}">Edit category</c:when><c:otherwise>Add category</c:otherwise></c:choose></h2><form method="post" action="${pageContext.request.contextPath}/admin/categories"><input type="hidden" name="action" value="${not empty editCategory ? 'update' : 'create'}"><c:if test="${not empty editCategory}"><input type="hidden" name="categoryId" value="${editCategory.categoryId}"></c:if><label>Name<input name="name" maxlength="120" value="<c:out value='${editCategory.name}'/>" required></label><label>Description<textarea name="description"><c:out value="${editCategory.description}"/></textarea></label><label>Status<select name="status"><option>ACTIVE</option><option ${not empty editCategory and not editCategory.status ? 'selected' : ''}>INACTIVE</option></select></label><button class="button" type="submit">Save category</button><c:if test="${not empty editCategory}"><a href="${pageContext.request.contextPath}/admin/categories">Cancel</a></c:if></form></section>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Name</th><th>Description</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach var="cat" items="${categories}"><tr><td><c:out value="${cat.categoryId}"/></td><td><c:out value="${cat.name}"/></td><td><c:out value="${cat.description}"/></td><td><c:out value="${cat.status ? 'ACTIVE' : 'INACTIVE'}"/></td><td><a href="${pageContext.request.contextPath}/admin/categories?id=${cat.categoryId}">Edit</a> <form method="post" action="${pageContext.request.contextPath}/admin/categories"><input type="hidden" name="action" value="delete"><input type="hidden" name="categoryId" value="${cat.categoryId}"><button class="link-button danger" type="submit">Delete</button></form></td></tr></c:forEach></tbody></table></div></main></div></body></html>
