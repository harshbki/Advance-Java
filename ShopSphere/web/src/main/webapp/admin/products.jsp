<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Products admin | ShopSphere</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"></head><body>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">ShopSphere Admin</a><nav><form method="post" action="${pageContext.request.contextPath}/logout"><button class="link-button" type="submit">Sign out</button></form></nav></header><div style="display: flex; min-height: calc(100vh - 65px);"><%@ include file="/fragments/sidebar.jsp" %><main class="content" style="flex: 1;"><h1>Product management</h1><c:if test="${isLowStockFilter}"><div class="alert alert-warning" role="alert"><strong>Low Stock Filter:</strong> Displaying only products with stock &le; 5. <a href="${pageContext.request.contextPath}/admin/products" class="alert-link">Show All Products</a></div></c:if><c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if><c:choose><c:when test="${not empty editProduct}"><c:set var="formProduct" value="${editProduct}"/><c:set var="formAction" value="update"/></c:when><c:otherwise><c:set var="formAction" value="create"/></c:otherwise></c:choose><section class="panel wide"><h2><c:choose><c:when test="${formAction == 'update'}">Edit product #<c:out value="${editProduct.productId}"/></c:when><c:otherwise>Add product</c:otherwise></c:choose></h2><form class="admin-form" method="post" action="${pageContext.request.contextPath}/admin/products"><input type="hidden" name="action" value="${formAction}"><c:if test="${formAction == 'update'}"><input type="hidden" name="productId" value="${editProduct.productId}"></c:if><label>Category<select name="categoryId" required><c:forEach var="cat" items="${categories}"><c:choose><c:when test="${not empty editProduct and editProduct.categoryId == cat.categoryId}"><option value="${cat.categoryId}" selected><c:out value="${cat.name}"/></option></c:when><c:otherwise><option value="${cat.categoryId}"><c:out value="${cat.name}"/></option></c:otherwise></c:choose></c:forEach></select></label><label>Name<input name="name" maxlength="180" value="<c:out value='${editProduct.name}'/>" required></label><label>Brand<input name="brand" maxlength="120" value="<c:out value='${editProduct.brand}'/>"></label><label>Price<input type="number" name="price" min="0" step="0.01" value="${editProduct.price}" required></label><label>Discount %<input type="number" name="discount" min="0" max="100" step="0.01" value="${empty editProduct ? 0 : editProduct.discount}" required></label><label>Stock<input type="number" name="stock" min="0" value="${empty editProduct ? 0 : editProduct.stock}" required></label><label>Image URL<input name="imageUrl" maxlength="500" value="<c:out value='${editProduct.imageUrl}'/>"></label><label>Status<select name="status"><c:choose><c:when test="${not empty editProduct and not editProduct.status}"><option>ACTIVE</option><option selected>INACTIVE</option></c:when><c:otherwise><option selected>ACTIVE</option><option>INACTIVE</option></c:otherwise></c:choose></select></label><label class="span-all">Description<textarea name="description"><c:out value="${editProduct.description}"/></textarea></label><button class="button" type="submit">Save product</button><c:if test="${formAction == 'update'}"><a href="${pageContext.request.contextPath}/admin/products">Cancel</a></c:if></form></section><h2 class="section-title">Products</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Product</th><th>Price</th><th>Stock</th><th>Status</th><th>Action</th></tr></thead><tbody><c:forEach var="p" items="${products}"><tr><td><c:out value="${p.productId}"/></td><td><c:out value="${p.name}"/></td><td>&#8377;<c:out value="${p.price}"/></td><td><c:out value="${p.stock}"/></td><td><c:out value="${p.status ? 'ACTIVE' : 'INACTIVE'}"/></td><td><a href="${pageContext.request.contextPath}/admin/products?id=${p.productId}">Edit</a> &middot; <form method="post" action="${pageContext.request.contextPath}/admin/products"><input type="hidden" name="action" value="delete"><input type="hidden" name="productId" value="${p.productId}"><button class="link-button danger" type="submit">Delete</button></form></td></tr></c:forEach></tbody></table></div></main></div></body></html>
