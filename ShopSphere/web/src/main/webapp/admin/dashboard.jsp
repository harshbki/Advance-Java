<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin dashboard | ShopSphere</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"></head>
<body><header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">ShopSphere Admin</a><nav><form method="post" action="${pageContext.request.contextPath}/logout"><button class="link-button" type="submit">Sign out</button></form></nav></header><div style="display: flex; min-height: calc(100vh - 65px);"><%@ include file="/fragments/sidebar.jsp" %><main class="content" style="flex: 1;"><p class="eyebrow">STORE OVERVIEW</p><h1>Dashboard</h1><div class="summary-grid"><article class="summary-card"><span>Products</span><strong><c:out value="${summary.products}"/></strong></article><article class="summary-card"><span>Customers</span><strong><c:out value="${summary.customers}"/></strong></article><article class="summary-card"><span>Orders</span><strong><c:out value="${summary.orders}"/></strong></article><a href="${pageContext.request.contextPath}/admin/products?filter=low_stock" class="summary-card text-decoration-none"><span>Low stock (Click to view)</span><strong style="color: #dc3545;"><c:out value="${summary.lowStock}"/></strong></a><article class="summary-card"><span>Sales total</span><strong>₹<c:out value="${summary.sales}"/></strong></article></div><p class="muted">Sales total excludes cancelled orders.</p></main></div></body></html>
