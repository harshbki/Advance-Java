<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Coupons | ShopSphere</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/shop.css"></head><body>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/admin/dashboard">ShopSphere Admin</a><nav><form method="post" action="${pageContext.request.contextPath}/logout"><button class="link-button" type="submit">Sign out</button></form></nav></header><div style="display: flex; min-height: calc(100vh - 65px);"><%@ include file="/fragments/sidebar.jsp" %><main class="content" style="flex: 1;"><h1>Coupon management</h1><c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if><section class="panel"><h2>Create coupon</h2><form method="post" action="${pageContext.request.contextPath}/admin/coupons"><label>Code<input name="code" maxlength="60" required></label><label>Discount type<select name="discountType"><option>PERCENT</option><option>FIXED</option></select></label><label>Discount value<input name="discountValue" type="number" min="0.01" step="0.01" required></label><label>Minimum order<input name="minimumOrder" type="number" min="0" step="0.01" value="0"></label><label>Maximum discount <span class="muted">(optional)</span><input name="maximumDiscount" type="number" min="0" step="0.01"></label><label>Status<select name="status"><option>ACTIVE</option><option>INACTIVE</option></select></label><button class="button" type="submit">Save coupon</button></form></section><div class="table-wrap"><table><thead><tr><th>Code</th><th>Type</th><th>Value</th><th>Minimum</th><th>Max discount</th><th>Status</th></tr></thead><tbody><c:forEach var="c" items="${coupons}"><tr><td><c:out value="${c.code}"/></td><td><c:out value="${c.discountType}"/></td><td><c:out value="${c.discountValue}"/></td><td>₹<c:out value="${c.minimumOrder}"/></td><td><c:out value="${c.maximumDiscount}"/></td><td><c:out value="${c.status}"/></td></tr></c:forEach></tbody></table></div></main></div></body></html>
